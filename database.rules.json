{
  "rules": {
    ".read": false,
    ".write": false,

    "config": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "clientes": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$clienteId": {
        "statusMensalidade": {
          ".read": true
        }
      }
    },

    "atendimentos": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp"]
    },

    "despesas": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "estoque": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "vales": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp"]
    },

    "painel_tv": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "servicos": {
      ".read": true,
      ".write": "auth != null"
    },

    "landingConfig": {
      ".read": true,
      ".write": "auth != null"
    },

    "vitrine_eventos": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["dataISO"]
    },

    "profissionais": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "profissionais_publicos": {
      ".read": true,
      ".write": "auth != null"
    },

    "disponibilidade": {
      ".read": true,
      ".write": "auth != null",
      "$data": {
        "$profissionalId": {
          "$hora": {
            ".write": "auth != null || (!data.exists() && newData.val() === true)",
            ".validate": "auth != null ? (newData.isBoolean() || newData.val() == null) : (newData.isBoolean() && $data.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && $profissionalId.matches(/^[0-9A-Za-z_-]{1,40}$/) && $hora.matches(/^[0-9]{2}-[0-9]{2}$/))"
          }
        }
      }
    },

    "agendamentos_publicos": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$id": {
        ".write": "auth != null || (!data.exists() && newData.exists())",
        ".validate": "newData.hasChildren(['nomeCliente','telefoneCliente','data','hora','servicoNome']) && (auth != null || (newData.child('criadoEm').isNumber() && newData.child('criadoEm').val() <= now + 300000 && newData.child('criadoEm').val() > now - 3600000))",
        "nomeCliente": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "telefoneCliente": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "data": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
        "hora": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,2}:[0-9]{2}$/)" },
        "servicoNome": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "obs": { ".validate": "newData.isString() && newData.val().length <= 400" },
        "profissionalNome": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "profissionalId": { ".validate": "newData.isString() || newData.isNumber() || newData.val() == null" },
        "valor": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
        "criadoEm": { ".validate": "newData.isNumber() && newData.val() <= now + 300000" },
        "status": { ".validate": "newData.isString() && (auth != null || newData.val() === 'pendente')" },
        "confirmadoEm": { ".validate": "auth != null && newData.isNumber()" },
        "$outro": { ".validate": "auth != null" }
      }
    },

    "leads_espera": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$id": {
        ".write": "auth != null || (!data.exists() && newData.exists())",
        ".validate": "newData.hasChildren(['nome','telefone','criadoEm'])",
        "nome": { ".validate": "newData.isString() && newData.val().length > 1 && newData.val().length <= 120" },
        "telefone": { ".validate": "newData.isString() && newData.val().matches(/^[0-9 ()+.-]{8,30}$/)" },
        "criadoEm": { ".validate": "newData.isNumber() && (auth != null || (newData.val() <= now + 300000 && newData.val() > now - 3600000))" },
        "origem": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "atendido": { ".validate": "auth != null && newData.isBoolean()" },
        "$outro": { ".validate": "auth != null" }
      }
    }
  }
}
