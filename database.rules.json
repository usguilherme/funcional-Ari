{
  "rules": {
    ".read": false,
    ".write": false,

    "config": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "clientes": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$clienteId": {
        "statusMensalidade": {
          ".read": true
        },
        "codigoCliente": {
          ".validate": "newData.val() == null || (newData.isString() && newData.val().length <= 40 && newData.val().matches(/^[A-Za-z0-9 ._-]*$/))"
        }
      }
    },

    "atendimentos": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp"]
    },

    "despesas": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "estoque": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "vales": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp"]
    },

    "painel_tv": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "servicos": {
      ".read": true,
      ".write": "auth != null"
    },

    "landingConfig": {
      ".read": true,
      ".write": "auth != null"
    },

    "vitrine_eventos": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["dataISO"]
    },

    "profissionais": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "profissionais_publicos": {
      ".read": true,
      ".write": "auth != null"
    },

    "disponibilidade": {
      ".read": true,
      ".write": "auth != null",
      "$data": {
        "$profissionalId": {
          "$hora": {
            ".validate": "newData.isBoolean() || newData.val() == null"
          }
        }
      }
    },

    "agendamentos_publicos": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$id": {
        ".validate": "newData.hasChildren(['nomeCliente','telefoneCliente','data','hora','servicoNome'])",
        "nomeCliente": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "telefoneCliente": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "data": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
        "hora": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,2}:[0-9]{2}$/)" },
        "servicoNome": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "obs": { ".validate": "newData.isString() && newData.val().length <= 400" },
        "profissionalNome": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "profissionalId": { ".validate": "newData.isString() || newData.isNumber() || newData.val() == null" },
        "valor": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
        "criadoEm": { ".validate": "newData.isNumber()" },
        "status": { ".validate": "newData.isString()" },
        "confirmadoEm": { ".validate": "newData.isNumber()" }
      }
    },

    "turmas_lotadas": {
      ".read": true,
      ".write": "auth != null",
      "atualizadoEm": { ".validate": "newData.isNumber()" },
      "$dia": {
        ".validate": "newData.isBoolean() || newData.isNumber() || newData.val() == null"
      }
    },

    "leads_espera": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$id": {
        ".validate": "newData.hasChildren(['nome','telefone','criadoEm'])",
        "nome": { ".validate": "newData.isString() && newData.val().length > 1 && newData.val().length <= 120" },
        "telefone": { ".validate": "newData.isString() && newData.val().matches(/^[0-9 ()+.-]{8,30}$/)" },
        "criadoEm": { ".validate": "newData.isNumber()" },
        "origem": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "atendido": { ".validate": "newData.isBoolean()" }
      }
    }
  }
}
