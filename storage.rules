rules_version = '2';

// Firebase Storage do Funcional do Ari.
// As imagens (fotos de alunos, galeria e vitrine) sao publicas para leitura
// porque aparecem no painel e na pagina publica. Escrita apenas autenticada,
// limitada a arquivos de imagem de ate 5 MB.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
