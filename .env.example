# Variáveis de ambiente das funções serverless (configurar na Vercel).
# Copie para .env.local para rodar localmente com `vercel dev`.

# --- Firebase Admin (Service Account) ---
# Console do Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada
FIREBASE_PROJECT_ID=funcional-ari
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@funcional-ari.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://funcional-ari-default-rtdb.firebaseio.com

# --- Mercado Pago ---
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx
# Segredo do webhook (Mercado Pago > Suas integrações > Webhooks > Assinatura secreta)
MERCADO_PAGO_WEBHOOK_SECRET=

# --- Configuração das APIs ---
# Origem(ns) permitida(s) no CORS. Use a URL de produção do site.
# Múltiplas separadas por vírgula. "*" libera qualquer origem (não recomendado).
ALLOWED_ORIGIN=https://funcionaldoari.vercel.app
# Teto de valor para uma cobrança Pix gerada pela Área do Aluno
PIX_VALOR_MAXIMO=2000
